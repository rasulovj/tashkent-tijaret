# Bu dosyayı .env adıyla kopyalayın ve doldurun:  cp .env.example .env
# Panelin adresi (DNS'te A kaydı bu sunucunun IP'sini göstermeli)
DOMAIN=panel.ornek-alanadi.uz
# Sertifika bildirimleri için e-posta
ACME_EMAIL=info@ornek.uz

# İsteğe bağlı: anahtarlar panelde Ayarlar'dan da girilebilir (config/keys.json'a yazılır)
# ANTHROPIC_API_KEY=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope

# Claude aylık harcama sınırı (ABD doları). Aşılınca çeviri/yazım durur, haberler toplanır.
AI_MONTHLY_LIMIT_USD=5
